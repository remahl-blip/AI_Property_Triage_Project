# n8n webhook that receives property submissions from the Streamlit app.
#
# Local dev (Streamlit on host, n8n via docker compose):
N8N_WEBHOOK_URL=http://localhost:5678/webhook/property-triage
#
# Docker compose (layer1_webui container -> n8n container):
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/property-triage

# Local Ollama configuration for the conversational assistant.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Shared request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=60
