      },
      {
        "parameters": {
          "method": "POST", "url": "http://langgraph_agent:8004/agent/run",
          "sendBody": true, "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ query: $('Guardrails Input').item.json.safe_text }) }}",
          "options": {}
        },
        "id": "n7-agent", "name": "LangGraph Agent", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
        "position": [1080, 400]
      },
      {
        "parameters": {
          "jsCode": "const webhook = $('Webhook').first().json;\nconst body = webhook.body ?? webhook;\nconst listing = body.listing ?? {};\nconst description = $('Guardrails Input').first().json.safe_text;\nconst images = listing.images ?? [];\nconst imageAnalyserUrl = 'http://image_analyser:8002/analyse';\nconst imageResults = [];\nif (images.length === 0) {\n  const meta = await this.helpers.httpRequest({ method: 'POST', url: imageAnalyserUrl, body: { condition_description: description, filename: 'listing.jpg' }, json: true });\n  imageResults.push({ filename: 'listing.jpg', analysis: meta });\n} else {\n  for (const image of images) {\n    const b64 = image.data_base64 ?? '';\n    if (!b64) continue;\n    const buffer = Buffer.from(b64, 'base64');\n    const analysis = await this.helpers.httpRequest({ method: 'POST', url: imageAnalyserUrl, formData: { file: { value: buffer, options: { filename: image.filename || 'upload.jpg', contentType: image.content_type || 'image/jpeg' } }, condition_description: description }, json: true });\n    imageResults.push({ filename: image.filename, analysis });\n  }\n}\nreturn [{ json: { image_results: imageResults, extracted: $('Info Extractor').first().json, rag: $('RAG Query').first().json, agent: $('LangGraph Agent').first().json, description, agent_name: listing.agent_name ?? '', property_type: listing.property_type ?? 'residential' } }];"
        },
        "id": "n8-images", "name": "Image Analyser", "type": "n8n-nodes-base.code", "typeVersion": 2,
        "position": [1300, 300]
      },
      {
        "parameters": {
          "method": "POST", "url": "http://llm_service:8006/agent",
          "sendBody": true, "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ extracted_fields: $json.extracted.extracted_fields, rag_result: $json.rag, image_results: $json.image_results, query: $json.description }) }}",
          "options": {}
        },
        "id": "n9-ai-agent", "name": "AI Agent Enrich", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
        "position": [1520, 300]
      },
      {
        "parameters": {
          "method": "POST", "url": "http://llm_service:8006/report",
          "sendBody": true, "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ extracted_fields: $('Image Analyser').item.json.extracted.extracted_fields, rag_result: $('Image Analyser').item.json.rag, image_results: $('Image Analyser').item.json.image_results, agent_result: $json.agent_result }) }}",
          "options": {}
        },
        "id": "n10-report", "name": "LLM Chain Report", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
        "position": [1740, 300]
      },
      {
        "parameters": {
          "method": "POST", "url": "http://guardrails_service:8005/check/output",
          "sendBody": true, "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ text: $json.report_markdown ?? '' }) }}",
          "options": {}
        },
        "id": "n11-guard-out", "name": "Guardrails Output", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
        "position": [1960, 300]
      },
      {
        "parameters": {
          "jsCode": "const ctx = $('Image Analyser').first().json;\nconst report = $('LLM Chain Report').first().json;\nconst outGuard = $input.first().json;\nconst ptype = (ctx.extracted?.extracted_fields?.property_type ?? ctx.property_type ?? 'residential').toLowerCase();\nconst commercial = ['office','retail','industrial','commercial','משרד','חנות'].some(k => ptype.includes(k));\nconst route = commercial ? 'commercial' : 'residential';\nreturn [{ json: { status: outGuard.pass ? 'success' : 'output_flagged', route, property_type: route, agent_name: ctx.agent_name, listing_description: ctx.description, extracted_fields: ctx.extracted?.extracted_fields, rag_result: ctx.rag, agent_result: ctx.agent, image_results: ctx.image_results, ai_agent: $('AI Agent Enrich').first().json, report_markdown: outGuard.safe_text || report.report_markdown, output_guardrails: outGuard, pipeline: 'full_guideline_flow' } }];"
        },
        "id": "n12-router", "name": "Router", "type": "n8n-nodes-base.code", "typeVersion": 2,
        "position": [2180, 300]
      },
